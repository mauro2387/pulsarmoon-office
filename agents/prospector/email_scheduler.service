[Unit]
Description=PulsarMoon Email Prospector Scheduler (09:00 daily)
After=network.target

[Service]
Type=simple
User=server
WorkingDirectory=/home/server/pulsarmoon-office
ExecStart=/home/server/pulsarmoon-office/.venv/bin/python -m agents.prospector.email_scheduler
Restart=always
RestartSec=30
EnvironmentFile=/home/server/pulsarmoon-office/.env

[Install]
WantedBy=multi-user.target
