[Unit]
Description=PulsarMoon Followup Panel
After=network.target

[Service]
Type=simple
User=server
WorkingDirectory=/home/server/pulsarmoon-office
ExecStart=/home/server/pulsarmoon-office/.venv/bin/python -m agents.seguimiento.panel_server
Restart=always
RestartSec=10
EnvironmentFile=/home/server/pulsarmoon-office/.env

[Install]
WantedBy=multi-user.target
