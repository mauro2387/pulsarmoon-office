[Unit]
Description=PulsarMoon Intelligence Agent
After=network.target

[Service]
Type=simple
User=server
WorkingDirectory=/home/server/pulsarmoon-office
ExecStart=/home/server/pulsarmoon-office/.venv/bin/python -m agents.inteligencia.scheduler
Restart=always
RestartSec=30
EnvironmentFile=/home/server/pulsarmoon-office/.env

[Install]
WantedBy=multi-user.target
